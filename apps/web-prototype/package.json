{
  "name": "ai-agent-team-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-service.ps1 -Action start",
    "stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-service.ps1 -Action stop",
    "restart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-service.ps1 -Action restart",
    "status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-service.ps1 -Action status",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "^6.0.0",
    "vite": "^8.1.0"
  }
}
