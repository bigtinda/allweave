# 依赖
node_modules/
.npm/
*.tgz

# 构建产物与缓存
# dist/ 与 build/ 保持通用规则：上游 pi-main 自身不提交 dist/，但会提交示例里的
# packages/coding-agent/examples/**/build/（预编译 wasm），因此不能在 vendor 下豁免 dist。
dist/
/build/
.vite/
*.tsbuildinfo

# 本机运行时状态、日志与进程记录
.dev-runtime/
*.log
npm-debug.log*

# 测试过程产生的临时工作区（egress 集成测试、工作区客户端测试）
.egress-api-test-*/
.workspace-client-test-*/

# 本机凭证与环境变量（严禁提交）
.env
.env.*
!.env.example

# Pi SDK / WPS MCP 的本机配置与缓存
# 仅限仓库根目录：vendor/pi-main/.pi/ 是上游源码（extensions/prompts/skills），必须入库
/.pi/
__pycache__/
*.py[cod]
.venv/
venv/

# 编辑器与操作系统
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
